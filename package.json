{
  "name": "clusem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLUSEM — reconstruction fidèle et animée d'une landing page de salle de sport (projet portfolio).",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "images": "node scripts/build-images.mjs",
    "dev": "node scripts/build-images.mjs && nuxt dev",
    "build": "nuxt build",
    "generate": "node scripts/build-images.mjs && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "verify": "pnpm check && pnpm generate && pnpm test:e2e"
  },
  "dependencies": {
    "@nuxt/image": "2.1.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "nuxt": "4.5.2",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/tektur": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "eslint-plugin-vuejs-accessibility": "2.6.0",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.12"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
